# Discourse environment configuration

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=discourse.example.com
BASE_DOMAIN_NAME=example.com

# Database
DB_CREATE_DATABASE_NAME=discourse
DB_USER_NAME=discourse
DB_USER_PASS=replace-with-a-random-password

# Email
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_LOGIN_NAME=replace-with-a-random-password
EMAIL_SERVER_LOGIN_PASS=replace-with-a-random-password
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
DISCOURSE_SKIP_EMAIL_SETUP=1
