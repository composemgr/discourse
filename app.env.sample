# Discourse - Open Source Forum Software
# https://www.discourse.org/

# Timezone
TZ=America/New_York

# Hostname / Domain
BASE_HOST_NAME=localhost
BASE_DOMAIN_NAME=example.com

# Admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password
APP_ADMIN_EMAIL=admin@example.com

# Site branding
APP_ORG_NAME=Discourse

# Database credentials (PostgreSQL)
DB_CREATE_DATABASE_NAME=discourse
DB_USER_NAME=discourse
DB_USER_PASS=changeme_db_password

# Email / SMTP settings
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
